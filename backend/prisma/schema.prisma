generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String
  email     String    @unique
  phone     String
  birthdate DateTime?
  status    String    @default("Activo")
  events    Event[]
  createdAt DateTime  @default(now())
}

model Event {
  id               Int               @id @default(autoincrement())
  name             String
  date             DateTime
  time             String?
  venue            String
  type             String
  status           String            @default("Propuesta")
  guests           Int
  budget           Float
  portalToken      String?           @unique
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         Int
  quotes           Quote[]
  payments         Payment[]
  supplierPayments SupplierPayment[]
  createdAt        DateTime          @default(now())
  checklist      ChecklistItem[]
  files          EventFile[]
  cateringItems  CateringItem[]
  menuSections   EventMenuSection[]
}

model Quote {
  id            Int         @id @default(autoincrement())
  kind          String      @default("General")
  date          DateTime    @default(now())
  status        String      @default("Pendiente")
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       Int
  menu          String?
  covers        Int?
  pricePerCover Float?
  items         QuoteItem[]
  dishes        QuoteDish[]
  createdAt     DateTime    @default(now())
}

model QuoteItem {
  id          Int    @id @default(autoincrement())
  description String
  quantity    Int
  unitPrice   Float
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     Int
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  date      DateTime @default(now())
  note      String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  createdAt DateTime @default(now())
}

model SupplierPayment {
  id         Int      @id @default(autoincrement())
  amount     Float
  date       DateTime @default(now())
  note       String?
  method     String   @default("Efectivo")
  status     String   @default("Pendiente")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    Int
  createdAt  DateTime @default(now())
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  category         String
  contact          String
  phone            String
  email            String            @unique
  rating           Int               @default(3)
  status           String            @default("Activo")
  alias            String?
  supplierPayments SupplierPayment[]
  cateringItems    CateringItem[]
  createdAt        DateTime          @default(now())
}

model ChecklistItem {
  id        Int      @id @default(autoincrement())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  createdAt DateTime @default(now())
}

model EventFile {
  id           Int      @id @default(autoincrement())
  name         String
  url          String
  publicId     String
  resourceType String   @default("raw")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      Int
  createdAt    DateTime @default(now())
}

model CateringItem {
  id             Int       @id @default(autoincrement())
  eventId        Int
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoria      String
  descripcion    String
  cantidad       Float
  unidad         String    @default("unidad")
  precioUnitario Float     @default(0)
  proveedorId    Int?
  proveedor      Supplier? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  proveedorLibre String?
  nota           String?
  createdAt      DateTime  @default(now())
}

// ── Recetario ──────────────────────────────────────────────

model Dish {
  id          Int              @id @default(autoincrement())
  name        String
  seccion     String           // "Entrada fría", "Plato principal", etc.
  descripcion String?
  ingredients DishIngredient[]
  menuItems   EventMenuItem[]
  quoteDishes QuoteDish[]
  createdAt   DateTime         @default(now())
}

model DishIngredient {
  id           Int    @id @default(autoincrement())
  dish         Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId       Int
  nombre       String
  cantidad     Float  // cantidad por persona
  unidad       String @default("g")
  categoria    String @default("Otros") // "Carnes", "Lácteos", "Verduras", "Bebidas", etc.
}

// ── Menú por evento ───────────────────────────────────────

model EventMenuSection {
  id        Int             @id @default(autoincrement())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  nombre    String          // "Entrada fría", "Plato principal", etc.
  orden     Int             @default(0)
  items     EventMenuItem[]
  createdAt DateTime        @default(now())
}

model EventMenuItem {
  id        Int              @id @default(autoincrement())
  section   EventMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int
  dish      Dish             @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId    Int
  nota      String?
  createdAt DateTime         @default(now())
}
// ── Contactos (agenda independiente) ─────────────────────

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  email     String   @default("")
  createdAt DateTime @default(now())
}

// ── Log de actividad ──────────────────────────────────────

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int?
  label     String
  detail    String?
  meta      String?
  createdAt DateTime @default(now())
}

// ── Platos en cotización de catering ─────────────────────

model QuoteDish {
  id      Int   @id @default(autoincrement())
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId Int
  dish    Dish  @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId  Int
  nota    String?
}
