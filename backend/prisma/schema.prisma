generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String
  email     String    @unique
  phone     String
  birthdate DateTime?
  status    String    @default("Inactivo")
  events    Event[]
  createdAt DateTime  @default(now())
}

model Event {
  id               Int               @id @default(autoincrement())
  name             String
  date             DateTime
  time             String?
  venue            String
  type             String
  status           String            @default("Propuesta")
  guests           Int
  budget           Decimal
  ticketPrice      Decimal?
  dietaryOptions   String?   // JSON: [{ key, label, cantidad }]
  portalToken      String?           @unique
  checkinToken     String?           @unique
  guestPortalToken   String?           @unique
  paidGuestListUrl   String?
  paidGuestListName  String?
  paidGuestListCount Int?
  budgetPublished    Boolean           @default(false)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         Int
  quotes           Quote[]
  payments         Payment[]
  supplierPayments SupplierPayment[]
  createdAt        DateTime          @default(now())
  checklist      ChecklistItem[]
  files          EventFile[]
  cateringItems  CateringItem[]
  portalQueries  PortalQuery[]
  scheduleItems  ScheduleItem[]
  eventGuests    EventGuest[]
}

model Quote {
  id              Int         @id @default(autoincrement())
  kind            String      @default("General")
  date            DateTime    @default(now())
  status          String      @default("Pendiente")
  clientStatus    String?
  clientDecidedAt DateTime?
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         Int
  covers          Int?
  pricePerCover   Decimal?
  items           QuoteItem[]
  dishes          QuoteDish[]
  menus           QuoteMenu[]
  createdAt       DateTime    @default(now())
}

model QuoteItem {
  id          Int    @id @default(autoincrement())
  description String
  quantity    Int
  unitPrice   Decimal
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     Int
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  date      DateTime @default(now())
  note      String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  createdAt DateTime @default(now())
}

model SupplierPayment {
  id         Int      @id @default(autoincrement())
  amount     Decimal
  date       DateTime @default(now())
  note       String?
  method     String   @default("Efectivo")
  status     String   @default("Pendiente")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    Int
  createdAt  DateTime @default(now())
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  category         String
  contact          String
  phone            String
  email            String            @unique
  rating           Int               @default(3)
  status           String            @default("Activo")
  alias            String?
  supplierPayments SupplierPayment[]
  cateringItems    CateringItem[]
  createdAt        DateTime          @default(now())
}

model ChecklistItem {
  id        Int      @id @default(autoincrement())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  createdAt DateTime @default(now())
}

model EventFile {
  id           Int      @id @default(autoincrement())
  name         String
  url          String
  publicId     String
  resourceType String   @default("raw")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      Int
  createdAt    DateTime @default(now())
}

model CateringItem {
  id             Int       @id @default(autoincrement())
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        Int
  categoria      String
  descripcion    String
  cantidad       Decimal
  unidad         String    @default("unidad")
  precioUnitario Decimal     @default(0)
  proveedor      Supplier? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  proveedorId    Int?
  proveedorLibre String?
  nota           String?
  createdAt      DateTime  @default(now())
}


// ── Recetario ──────────────────────────────────────────────

model Dish {
  id          Int               @id @default(autoincrement())
  name        String
  seccion     String
  descripcion String?
  ingredients DishIngredient[]
  menuItems   MenuSectionItem[]
  quoteDishes QuoteDish[]
  createdAt   DateTime          @default(now())
}

model DishIngredient {
  id           Int    @id @default(autoincrement())
  dish         Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId       Int
  nombre       String
  cantidad     Decimal  // cantidad por persona
  unidad       String @default("g")
  categoria    String @default("Otros") // "Carnes", "Lácteos", "Verduras", "Bebidas", etc.
}

// ── Contactos (agenda independiente) ─────────────────────

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  email     String   @default("")
  createdAt DateTime @default(now())
}

// ── Cronograma del evento ─────────────────────────────────

model ScheduleItem {
  id          Int      @id @default(autoincrement())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     Int
  hora        String
  titulo      String
  descripcion String?
  categoria   String   @default("Protocolo")
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ── Consultas del portal del cliente ─────────────────────

model PortalQuery {
  id        Int      @id @default(autoincrement())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  question  String
  status    String   @default("pending") // pending | resolved
  createdAt DateTime @default(now())
}

// ── Lista de invitados por evento ─────────────────────────

model EventGuest {
  id        Int      @id @default(autoincrement())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  name      String
  tipo      String   @default("Mayor") // "Mayor" | "Menor"
  pagado         Boolean  @default(false)
  pagadoEnPuerta Boolean  @default(false)
  ingreso        Boolean  @default(false)
  confirmed      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Log de actividad ──────────────────────────────────────

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int?
  label     String
  detail    String?
  meta      String?
  createdAt DateTime @default(now())
}

// ── Platos en cotización de catering ─────────────────────

model QuoteDish {
  id      Int   @id @default(autoincrement())
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId Int
  dish    Dish  @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId  Int
  nota    String?
}

// ── Menús globales (independientes de eventos) ────────────

model Menu {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  sections    MenuSection[]
  quotes      QuoteMenu[]
  createdAt   DateTime      @default(now())
}

model MenuSection {
  id        Int               @id @default(autoincrement())
  menu      Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    Int
  nombre    String
  orden     Int               @default(0)
  items     MenuSectionItem[]
  createdAt DateTime          @default(now())
}

model MenuSectionItem {
  id        Int         @id @default(autoincrement())
  section   MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int
  dish      Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId    Int
  nota      String?
  createdAt DateTime    @default(now())
}

model QuoteMenu {
  id      Int   @id @default(autoincrement())
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId Int
  menu    Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId  Int
}
